{
  "keyword": "blog-content-gap-check",
  "name": "Blog Content Gap Check",
  "description": "Find content gaps for selected clients. Create and schedule blog posts.",
  "notes": [
    "Step 1 counts posts scheduled and published this month against the site editorial package (Standard 2, Lite 1).",
    "Step 2 runs Post creator only when the gap is greater than zero; post count and GSC keywords come from the gap step.",
    "Bind a workflow client with Standard or Lite set on Integrations (or a known property name map)."
