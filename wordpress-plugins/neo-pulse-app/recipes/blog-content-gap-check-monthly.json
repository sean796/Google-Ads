  "category": "editorial",
  "verticals": ["editorial", "general"],
  "tags": ["posts", "editorial", "content-gap", "workflow", "monthly"],
  "prerequisites": ["wordpress", "gsc"],
  "filters": {
    "executionKinds": ["content_gap_check", "post_creator"],
    "targetBuckets": ["posts"],
    "actionCount": 2
